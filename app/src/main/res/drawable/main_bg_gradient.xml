<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Background -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#F3E5F5"
                android:centerColor="#E8F5E9"
                android:endColor="#E3F2FD"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Subtle Top-Left Glow -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.2"
                android:centerY="0.2"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Subtle Bottom-Right Glow -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.8"
                android:centerY="0.8"
                android:startColor="#309C27B0"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
